{# templates/base.html.twig #}
<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>
      {% block title %}
        Auto Cars - Luxury Car Marketplace
      {% endblock %}
    </title>

    {% block stylesheets %}
      <link href="{{ asset('assets/css/base.css') }}" rel="stylesheet" />
      <link href="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.3.0/flowbite.min.css" rel="stylesheet" />
      <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" crossorigin="anonymous" />
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    {% endblock %}
  </head>

  <body class="">
<header class="bg-white border-b">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">

      {# LOGO #}
      <a href="{{ path('app') }}" class="flex items-center gap-2">
        <img src="{{ asset('assets/img/logo/car.png') }}" alt="Auto Exchange Logo" class="w-auto p-16" />
      </a>

      {# NAVIGATION DESKTOP #}
      <nav class="hidden justify-center w-full lg:flex items-center gap-6 ml-10">
        <a href="{{ path('app_cars_achat') }}" class="text-sm font-medium text-[#222222] hover:text-primary">Achat</a>

        {% if app.user %}
          <a href="{{ path('app_cars_vente') }}" class="text-sm font-medium text-[#222222] hover:text-primary">Vente</a>
        {% endif %}

        <a href="{{ path('app_ccm') }}" class="text-sm font-medium text-[#222222] hover:text-primary">Comment ça marche</a>
        <a href="{{ path('app_contact') }}" class="text-sm font-medium text-[#222222] hover:text-primary">Contact</a>
      </nav>

      {# ACTIONS À DROITE #}
      <div class="hidden lg:flex items-center gap-4 ml-auto">
        {% if app.user %}
          <a href="{{ path('app_message_conversation', { receiverId: app.user.id }) }}"
             class="py-2 px-3 text-sm font-medium rounded-xl transition text-primary hover:bg-primary/10">
            Message
          </a>
          <a href="{{ path('app_profil') }}"
             class="py-2 px-3 text-sm font-medium rounded-xl transition hover:text-primary">
            Profil
          </a>
          <a href="{{ path('app_logout') }}"
             class="py-2 px-3 text-sm font-medium rounded-xl transition hover:text-red-500">
            Déconnexion
          </a>
        {% else %}
          <a href="{{ path('app_login') }}"
             class="px-4 py-2 text-sm font-bold bg-primary/10 text-primary rounded-lg hover:bg-primary/20 transition-colors">
            Connexion
          </a>
          <a href="{{ path('app_register') }}"
             class="px-4 py-2 text-sm font-bold text-[#222222] rounded-lg hover:text-primary transition-colors">
            Inscription
          </a>
        {% endif %}
      </div>

      {# BOUTON MOBILE #}
      <button id="menu-toggle" class="lg:hidden p-2 text-gray-600 hover:text-primary focus:outline-none">
        <span class="material-symbols-outlined text-2xl">menu</span>
      </button>
    </div>
  </div>

  {# MENU MOBILE #}
  <nav id="mobile-menu" class="lg:hidden hidden flex-col gap-4 bg-white p-4 border-t">
    <a href="{{ path('app_cars_achat') }}" class="text-sm font-medium text-[#222222]">Achat</a>

    {% if app.user %}
      <a href="{{ path('app_cars_vente') }}" class="text-sm font-medium text-[#222222]">Vente</a>
    {% endif %}

    <a href="{{ path('app_ccm') }}" class="text-sm font-medium text-[#222222]">Comment ça marche</a>
    <a href="{{ path('app_contact') }}" class="text-sm font-medium text-[#222222]">Contact</a>

    {% if app.user %}
      <a href="{{ path('app_message_conversation', { receiverId: app.user.id }) }}"
         class="py-2 px-2 text-sm rounded-xl transition text-primary">Message</a>
      <a href="{{ path('app_profil') }}" class="py-2 px-4 text-sm">Profil</a>
      <a href="{{ path('app_logout') }}" class="py-2 px-4 text-sm text-red-500">Déconnexion</a>
    {% else %}
      <a href="{{ path('app_login') }}"
         class="px-4 py-2 text-sm font-bold bg-primary/10 text-primary rounded-lg hover:bg-primary/20 transition-colors">
        Connexion
      </a>
      <a href="{{ path('app_register') }}"
         class="px-4 py-2 text-sm font-bold text-[#222222] rounded-lg transition-colors">
        Inscription
      </a>
    {% endif %}
  </nav>
</header>

    {# MAIN #}
    <main class="flex-grow">
      {% block body %}
      {% endblock %}
    </main>

    {# FOOTER #}
    <footer class="bg-background-light dark:bg-background-dark border-t border-gray-200 dark:border-gray-800">
      <div class="container mx-auto px-4 py-8">
        <div class="flex flex-col md:flex-row justify-between items-center text-center md:text-left">
          <div class="flex flex-wrap justify-center md:justify-start gap-x-6 gap-y-2 mb-4 md:mb-0">
            <a href="{{ path('app_cookies') }}" class="text-sm text-gray-600 hover:text-primary">À propos</a>
            <a href="{{ path('app_contact') }}" class="text-sm text-gray-600 hover:text-primary">Contact</a>
            <a href="{{ path('app_cgu') }}" class="text-sm text-gray-600 hover:text-primary">Conditions d’utilisation</a>
            <a href="{{ path('app_pdc') }}" class="text-sm text-gray-600 hover:text-primary">Politique de confidentialité</a>
          </div>
          <p class="text-sm text-gray-500">© {{ 'now'|date('Y') }} Auto Exchange. Tous droits réservés.</p>
        </div>
      </div>
    </footer>

    {# JAVASCRIPTS #}
    {% block javascripts %}
      <script src="https://cdn.tailwindcss.com"></script>
      <script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.3.0/flowbite.min.js"></script>
      <script>
        document.addEventListener('DOMContentLoaded', function () {
          const burger = document.querySelector('.navbar-burger')
          const menu = document.querySelector('.navbar-menu')
          const close = document.querySelector('.navbar-close')
        
          if (burger && menu) {
            burger.addEventListener('click', () => {
              menu.classList.remove('hidden')
            })
          }
        
          if (close && menu) {
            close.addEventListener('click', () => {
              menu.classList.add('hidden')
            })
          }
        
          // fermer si clic en dehors du menu
          menu?.addEventListener('click', (e) => {
            if (e.target === menu) {
              menu.classList.add('hidden')
            }
          })
        })
      </script>
    {% endblock %}
  </body>
</html>
