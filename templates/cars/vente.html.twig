{% extends 'base.html.twig' %}

{% block title %}Vendre un véhicule{% endblock %}

{% block body %}
<body class="bg-background-light dark:bg-background-dark font-display">

<div class="relative flex h-auto min-h-screen w-full flex-col overflow-x-hidden">
  <div class="flex h-full grow flex-col">
    <div class="flex-1 px-4 sm:px-6 lg:px-8 py-8 lg:py-12">
      <div class="mx-auto max-w-4xl">
        <div class="mb-8">
          <h1 class="text-3xl lg:text-4xl font-bold text-[#222222]">Vendre un véhicule</h1>
          <p class="mt-2 text-base text-[#222222]">Merci de renseigner les détails de votre véhicule.</p>
        </div>

        <!-- FORMULAIRE SYMFONY -->
        <div class="bg-white dark:bg-background-dark shadow-sm rounded-xl p-6 md:p-8">
          {{ form_start(form, {'attr': {'class': 'grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-6'}})}}

          <div class="flex flex-col">
            {{ form_label(form.type, 'Type', {'label_attr': {'class': 'text-sm font-medium text-[#222222] mb-2'}}) }}
            {{ form_widget(form.type, {'attr': {'class': 'form-select w-full rounded-lg border-stone-300 dark:border-stone-700 bg-background-light dark:bg-background-dark text-#222222 h-12'}}) }}
            {{ form_errors(form.type) }}
          </div>

          <div class="flex flex-col">
            {{ form_label(form.brand, 'Marque', {'label_attr': {'class': 'text-sm font-medium text-[#222222] mb-2'}}) }}
            {{ form_widget(form.brand, {'attr': {'class': 'form-input w-full rounded-lg border-stone-300 dark:border-stone-700 bg-background-light dark:bg-background-dark h-12'}}) }}
            {{ form_errors(form.brand) }}
          </div>

          <div class="flex flex-col">
            {{ form_label(form.model, 'Modèle', {'label_attr': {'class': 'text-sm font-medium text-[#222222] mb-2'}}) }}
            {{ form_widget(form.model, {'attr': {'class': 'form-input w-full rounded-lg border-stone-300 dark:border-stone-700 bg-background-light dark:bg-background-dark h-12'}}) }}
            {{ form_errors(form.model) }}
          </div>

          <div class="flex flex-col">
            {{ form_label(form.year, 'Année', {'label_attr': {'class': 'text-sm font-medium text-[#222222] mb-2'}}) }}
            {{ form_widget(form.year, {'attr': {'class': 'form-select w-full rounded-lg border-stone-300 dark:border-stone-700 bg-background-light dark:bg-background-dark h-12'}}) }}
            {{ form_errors(form.year) }}
          </div>

          <div class="flex flex-col">
            {{ form_label(form.mileage, 'Kilométrage', {'label_attr': {'class': 'text-sm font-medium text-[#222222] mb-2'}}) }}
            {{ form_widget(form.mileage, {'attr': {'class': 'form-input w-full rounded-lg border-stone-300 dark:border-stone-700 bg-background-light dark:bg-background-dark h-12'}}) }}
            {{ form_errors(form.mileage) }}
          </div>

          <div class="flex flex-col">
            {{ form_label(form.fuel, 'Carburant', {'label_attr': {'class': 'text-sm font-medium text-[#222222] mb-2'}}) }}
            {{ form_widget(form.fuel, {'attr': {'class': 'form-select w-full rounded-lg border-stone-300 dark:border-stone-700 bg-background-light dark:bg-background-dark h-12'}}) }}
            {{ form_errors(form.fuel) }}
          </div>

          <div class="flex flex-col">
            {{ form_label(form.gearBox, 'Boîte à vitesse', {'label_attr': {'class': 'text-sm font-medium text-[#222222] mb-2'}}) }}
            {{ form_widget(form.gearBox, {'attr': {'class': 'form-select w-full rounded-lg border-stone-300 dark:border-stone-700 bg-background-light dark:bg-background-dark h-12'}}) }}
            {{ form_errors(form.gearBox) }}
          </div>

          <div class="flex flex-col">
            {{ form_label(form.price, 'Prix', {'label_attr': {'class': 'text-sm font-medium text-[#222222] mb-2'}}) }}
            {{ form_widget(form.price, {'attr': {'class': 'form-input w-full rounded-lg border-stone-300 dark:border-stone-700 bg-background-light dark:bg-background-dark h-12'}}) }}
            {{ form_errors(form.price) }}
          </div>

          <!-- Description + Photo -->
          <div class="md:col-span-2 flex flex-col md:flex-row gap-6 mt-6">
            <div class="flex flex-col w-full md:w-1/2">
              {{ form_label(form.description, 'Description', {'label_attr': {'class': 'text-sm font-medium text-[#222222] mb-2'}}) }}
              {{ form_widget(form.description, {'attr': {'class': 'form-input w-full rounded-lg border-stone-300 dark:border-stone-700 bg-background-light dark:bg-background-dark'}}) }}
              {{ form_errors(form.description) }}
            </div>
            <div class="flex flex-col w-full md:w-1/2">
              {{ form_label(form.picture, 'Photo', {'label_attr': {'class': 'text-sm font-medium text-[#222222] mb-2'}}) }}
              {{ form_widget(form.picture, {'attr': {'class': 'form-control-file w-full rounded-lg border-stone-300 dark:border-stone-700 bg-background-light dark:bg-background-dark'}}) }}
              {{ form_errors(form.picture) }}
            </div>
          </div>

          <!-- SUBMIT -->
          <div class="md:col-span-2 flex justify-end mt-6">
            <button type="submit" class="flex items-center justify-center rounded-lg h-12 px-6 bg-[#3093D9] text-white text-sm font-bold leading-normal tracking-wide  transition-colors">
              <span>Mettre en vente</span>
            </button>
          </div>

          {{ form_end(form) }}
        </div>
      </div>
    </div>
  </div>
</div>

</body>
{% endblock %}
