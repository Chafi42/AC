{# templates/car/show.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}
  {{ car.brand }} {{ car.model }} - Auto Exchange
{% endblock %}

{% block stylesheets %}
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;700;900&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
{% endblock %}

{% block body %}
  <body class="bg-background-light dark:bg-background-dark font-display text-gray-800 dark:text-gray-200">
    <div class="flex flex-col min-h-screen">
      {# div CONTENT #}
      <div class="flex-grow container mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="max-w-4xl mx-auto">
          {# Fil d’Ariane #}
          <div class="mb-6 text-sm text-gray-500 dark:text-gray-400">
            <a href="{{ path('app_cars_achat') }}" class="hover:text-primary">Voitures</a>
            <span>/</span>
            <span class="text-gray-800 dark:text-gray-200">{{ car.year }} {{ car.model }}</span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-5 gap-8">
            {# Image principale #}
            <div class="md:col-span-3">
              {% if (pictures|length) > 0 %}
                <div class="relative aspect-[4/3] rounded-lg overflow-hidden shadow-lg">
                  <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('{{ asset('assets/img/cars-users/') ~ pictures[0].name }}');"></div>
                </div>
              {% else %}
                <div class="relative aspect-[4/3] rounded-lg overflow-hidden shadow-lg bg-gray-200 flex items-center justify-center">
                  <span class="text-gray-500">Aucune image disponible</span>
                </div>
              {% endif %}
            </div>

            {# Détails véhicule à droite #}
            <div class="md:col-span-2">
              <div class="p-6 rounded-lg shadow-2xl border border-gray-200">
                <h1 class="text-3xl font-bold">{{ car.year }} {{ car.brand }} {{ car.model }}</h1>
                <p class="text-gray-500 uppercase mt-1">{{ car.type }}</p>
                <div class="mt-4 pt-4 border-t border-gray-200">
                  <p class="text-4xl font-bold text-[#3093D9]">€{{ car.price }}</p>
                </div>
                <div class="mt-6 space-y-3">
                  {% if app.user %}
                    <a href="{{ path('app_message_new', { id: car.id }) }}" class="w-full bg-[#3093D9] text-white font-bold py-3 px-4 rounded-lg transition-colors flex items-center justify-center gap-2">
                      <span class="material-symbols-outlined">mail</span> Contacter le vendeur
                    </a>

					<a href="{{ path('app_message_new', { id: car.id }) }}" class="w-full text-[#3093D9] bg-[#DFEBF4] font-bold py-3 px-4 rounded-lg transition-colors flex items-center justify-center gap-2">
                      <span class="material-symbols-outlined">mail</span> Faire une offre
                    </a>

					
                  {% else %}
                    <a href="{{ path('app_login') }}" class="w-full bg-primary text-white font-bold py-3 px-4 rounded-lg hover:bg-primary/90 transition-colors flex items-center justify-center gap-2"><span class="material-symbols-outlined">login</span> Connectez-vous pour contacter</a>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>

          {# Spécifications #}
          <div class="mt-12">
            <h2 class="text-2xl font-bold border-b pb-3 mb-4">Spécifications</h2>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-x-6 gap-4 text-sm">
              <div class="flex flex-col">
                <span class="text-gray-500">Année</span><span class="font-medium">{{ car.year }}</span>
              </div>
              <div class="flex flex-col">
                <span class="text-gray-500">Kilométrage</span><span class="font-medium">{{ car.mileage }} km</span>
              </div>
              <div class="flex flex-col">
                <span class="text-gray-500">Carburant</span><span class="font-medium">{{ car.fuel }}</span>
              </div>
              <div class="flex flex-col">
                <span class="text-gray-500">Type</span><span class="font-medium">{{ car.type }}</span>
              </div>
              <div class="flex flex-col">
                <span class="text-gray-500">Marque</span><span class="font-medium">{{ car.brand }}</span>
              </div>
              <div class="flex flex-col">
                <span class="text-gray-500">Modèle</span><span class="font-medium">{{ car.model }}</span>
              </div>
            </div>
          </div>

          {# Description #}
          <div class="mt-12">
            <h2 class="text-2xl font-bold border-b pb-3 mb-4">Description</h2>
            <div class="bg-background-light p-6 rounded-lg shadow-md border flex items-center gap-6">
              <div class="flex-grow">
                <p class="font-bold text-lg mt-8">{{ car.description }}</p>
                
                <div class="mt-6 text-sm text-gray-500">
				  <p>Publié le {{ car.createdAt|date('d/m/Y') }}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
{% endblock %}
