{# templates/home/home.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}
  Auto Exchange - Trouvez votre voiture idéale
{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('assets/css/home.css') }}" />
{% endblock %}

{% block body %}
  <div class="flex flex-col min-h-screen">
    {# HERO #}
    <section class="relative h-[600px] flex items-center justify-center text-center bg-cover bg-center" style="background-image: linear-gradient(rgba(0,0,0,0.2),rgba(0,0,0,0.6)), url('{{ asset('assets/img/accueil/bg-home.png') }}');">
      <div class="container mx-auto px-4 text-white">
        <h1 class="text-4xl md:text-6xl font-black mb-4">Trouvez votre voiture idéale</h1>
        <p class="text-lg md:text-xl max-w-3xl mx-auto mb-8">Découvrez une large sélection de véhicules proposés par des vendeurs de confiance. Achetez, vendez ou échangez en toute sérénité.</p>
        <div class="max-w-2xl mx-auto">
          <form action="{{ path('app_cars_achat') }}" method="get" class="flex items-center bg-white dark:bg-background-dark gap-4 rounded-lg shadow-lg">
            <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" fill="#DADCE1" height="25" width="25" class="ml-4" version="1.1" id="Layer_1" viewBox="0 0 512 512" xml:space="preserve">
              <g>
                <g>
                  <path d="M281.1,0c-127.318,0-230.9,103.582-230.9,230.9c0,45.12,13.019,87.25,35.483,122.853l-70.654,70.654    c-20.039,20.039-20.039,52.527,0,72.564c20.039,20.039,52.527,20.039,72.564,0l70.654-70.654    c35.605,22.464,77.735,35.483,122.853,35.483c127.318,0,230.9-103.582,230.9-230.9S408.42,0,281.1,0z M281.1,410.489    c-99.025,0-179.589-80.564-179.589-179.589S182.074,51.311,281.1,51.311S460.689,131.875,460.689,230.9    S380.127,410.489,281.1,410.489z" />
                </g>
              </g>
            </svg>
            <input type="text" name="q" placeholder="Recherchez une voiture..." class="w-full h-14 bg-transparent border-none focus:ring-0 text-gray-800 dark:text-gray-200 placeholder-gray-400" />
            <a href="{{ path('app_cars_achat') }}" class="bg-[#3093D9] text-white font-bold px-8 py-4 rounded-lg text-lg">Rechercher</a>
          </form>
        </div>
      </div>
    </section>

    {# ANNONCES EN VEDETTE #}
    <section class="py-16 md:py-24 bg-background-light dark:bg-background-dark">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12 text-[#222222]">Véhicules en vedette</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {% for car in cars %}
            <a href="{{ path('app_cars_show', { id: car.id }) }}" class="block group">
              <div class="bg-white dark:bg-background-dark/50 rounded-xl overflow-hidden shadow-md group-hover:shadow-xl transition-shadow duration-300">
                {% if car.pictures is not empty %}
                  <img src="{{ asset('assets/img/cars-users/' ~ car.pictures|first.name) }}" alt="{{ car.brand }} {{ car.model }} ({{ car.year }})" class="w-full h-56 object-cover group-hover:scale-105 transition-transform duration-300" />
                {% else %}
                  <img src="{{ asset('assets/img/placeholder-car.jpg') }}" alt="Image non disponible" class="w-full h-56 object-cover group-hover:scale-105 transition-transform duration-300" />
                {% endif %}

                <div class="p-6">
                  <h3 class="font-bold text-lg text-[#222222] mb-2">{{ car.brand }} {{ car.model }} - {{ car.year }}</h3>
                  <p class="text-primary font-bold mt-2 text-[#3093D9]">{{ car.price|number_format(0, ',', ' ') }} €</p>
                </div>
              </div>
            </a>
          {% else %}
            <p class="text-center text-gray-500">Aucun véhicule disponible pour le moment.</p>
          {% endfor %}
        </div>
      </div>
    </section>

    {# CTA VENTE #}
    <section class="bg-[#DFEBF4] py-16 md:py-24">
      <div class="container mx-auto px-4 text-center">
        <h2 class="text-3xl font-bold mb-4 text-[#222222]">Vendez votre véhicule facilement</h2>
        <p class="text-lg max-w-2xl mx-auto mb-10 text-[#222222]">Publiez votre annonce en quelques minutes et touchez des milliers d'acheteurs potentiels.</p>
        <a href="{{ path('app_cars_vente') }}" class="bg-[#3093D9] text-white font-bold px-8 py-4 rounded-lg text-lg">Déposer une annonce</a>
      </div>
    </section>
  </div>
{% endblock %}
